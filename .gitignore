/target
.claude/

# The wasm client is excluded from the workspace, so the anchored `/target`
# above does not reach its build directory.
crates/agent-share-wasm-client/target/

# Front-end dependencies and build output.
node_modules/
/dist/

# wasm-bindgen output, rebuilt by `cargo task web-wasm`. Checked-in build
# artifacts drift from the source they were generated from, and this one is
# 2.8 MB per target.
crates/agent-share-wasm-client/dist/

# Generated: the hash of whatever wasm this machine last built. Tracking it made
# `git checkout` rewrite the path under a running dev server, which is the
# desync the content-addressed name exists to prevent. Regenerated by `bun run
# dev|build|preview` and by `scripts/gen-wasm-path.ts`.
packages/agent-share-wasm/src/path.ts

# Generated: the JS glue mirrored from the crate's dist/web/ into the package,
# so the dev bundler's watcher (which never leaves packages/) sees glue changes
# and rebundles — without the mirror, a `cargo task web-wasm` mid-session paired
# a fresh binary with stale glue and failed to instantiate. Synced by
# `scripts/wasm-asset.ts`.
packages/agent-share-wasm/src/glue/
